# Public URLs must use HTTPS. Never put access tokens in this file.
OIDC_ISSUER=https://auth.example.com/realms/example
MCP_RESOURCE=https://sync.example.com/mcp
OIDC_ROLE_CLIENT_ID=sp-mcp
OIDC_READ_ROLE=mcp.read
OIDC_WRITE_ROLE=mcp.write

# Default: reachable only from this host. Use a private interface explicitly
# when the reverse proxy runs on a different host.
MCP_BIND_ADDRESS=127.0.0.1
MCP_HOST_PORT=1901
LOCAL_UID=1000
LOCAL_GID=1000
